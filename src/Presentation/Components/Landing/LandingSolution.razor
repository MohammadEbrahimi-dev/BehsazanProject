<section class="landing-section landing-section-muted" id="solution" aria-labelledby="landing-solution-title">
    <div class="landing-section-inner">
        <p class="landing-section-kicker">راه‌حل</p>
        <h2 id="landing-solution-title" class="landing-section-title">از فایل‌های پراکنده تا یک سامانه متمرکز</h2>
        <p class="landing-section-lead">
            به جای چند فایل Excel و فرآیندهای دستی، اطلاعات در یک سیستم یکپارچه
            مدیریت می‌شوند — از مشتری تا گزارش مالی.
        </p>

        <div class="landing-compare" role="group" aria-label="مقایسه روش قبلی و سامانه جدید">
            <div class="landing-compare-col landing-compare-before">
                <h3 class="landing-compare-heading">روش قبلی</h3>
                <ul class="landing-compare-list">
                    <li>Excel و ورود دستی</li>
                    <li>ساخت دستی فاکتور و PDF</li>
                    <li>محاسبات پراکنده</li>
                    <li>فایل‌های جدا و وابسته به یک نفر</li>
                </ul>
            </div>
            <div class="landing-compare-divider" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" />
            </div>
            <div class="landing-compare-col landing-compare-after">
                <h3 class="landing-compare-heading">سامانه جدید</h3>
                <ul class="landing-compare-list">
                    <li>مشتری و پروژه در یکجا</li>
                    <li>فاکتور و پرداخت یکپارچه</li>
                    <li>دفتر کل پروژه و مانده حساب</li>
                    <li>گزارش مالی و خروجی Excel / PDF</li>
                </ul>
            </div>
        </div>
    </div>
</section>
