@page "/access-denied"
@layout Layout.EmptyLayout
@attribute [AllowAnonymous]
@inject NavigationManager NavManager
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<PageTitle>دسترسی غیرمجاز | بهسازان</PageTitle>

<div class="auth-gate">
    <div class="auth-gate-card animate-fade-up">
        <div class="auth-gate-icon auth-gate-icon-warn">
            <MudIcon Icon="@Icons.Material.Outlined.GppBad" Size="Size.Large" />
        </div>
        <MudText Typo="Typo.h5" Class="mb-2">دسترسی غیرمجاز</MudText>
        <MudText Typo="Typo.body1" Class="auth-gate-message mb-6">
            شما اجازه دسترسی به این صفحه را ندارید.
        </MudText>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   FullWidth="true"
                   Href="/dashboard"
                   StartIcon="@Icons.Material.Outlined.Dashboard"
                   Class="mb-2">
            بازگشت به داشبورد
        </MudButton>
        <MudButton Color="Color.Secondary"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   OnClick="HandleLogoutAsync"
                   StartIcon="@Icons.Material.Outlined.Logout">
            خروج از حساب
        </MudButton>
    </div>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Snackbar.Add("با موفقیت خارج شدید", Severity.Info);
        NavManager.NavigateTo("/login");
    }
}
