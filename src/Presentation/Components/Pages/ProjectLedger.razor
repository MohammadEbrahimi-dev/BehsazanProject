@page "/projects/{Id:int}/ledger"
@attribute [Authorize]
@inject IProjectLedgerService LedgerService
@inject IProjectFinancialReportService ReportService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>@(_ledger is null ? "دفتر کل پروژه" : $"دفتر کل — {_ledger.ProjectName}") | بهسازان</PageTitle>

<div class="page">
    @if (_isLoading)
    {
        <div class="panel">
            <MudProgressLinear Indeterminate="true" Rounded="true" Color="Color.Primary" />
            <p class="table-empty">در حال بارگذاری دفتر کل...</p>
        </div>
    }
    else if (_ledger is null)
    {
        <div class="panel table-empty">
            <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Size="Size.Large" />
            <p>پروژه مورد نظر یافت نشد یا حذف شده است.</p>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.ArrowForward"
                       OnClick="GoToProjects">
                بازگشت به لیست پروژه‌ها
            </MudButton>
        </div>
    }
    else
    {
        <header class="page-header animate-fade-in">
            <div class="detail-identity">
                <MudAvatar Color="Color.Info" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" />
                </MudAvatar>
                <div>
                    <h1 class="page-title">دفتر کل پروژه</h1>
                    <p class="page-subtitle">
                        <MudLink Underline="Underline.Hover"
                                 Color="Color.Primary"
                                 OnClick="GoToProject">
                            @_ledger.ProjectName
                        </MudLink>
                        <span class="muted"> — </span>
                        <MudLink Underline="Underline.Hover"
                                 Color="Color.Default"
                                 OnClick="GoToCustomer">
                            @_ledger.CustomerFullName
                        </MudLink>
                    </p>
                </div>
            </div>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.Apartment"
                           OnClick="GoToProject">
                    صفحه پروژه
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Person"
                           OnClick="GoToCustomer">
                    صفحه مشتری
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Success"
                           StartIcon="@Icons.Custom.FileFormats.FileExcel"
                           OnClick="ExportExcelAsync"
                           Disabled="_isExporting">
                    خروجی اکسل
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Outlined.PictureAsPdf"
                           OnClick="ExportPdfAsync"
                           Disabled="_isExporting">
                    خروجی PDF
                </MudButton>
            </MudStack>
        </header>

        <section class="detail-facts animate-fade-up">
            <article class="fact-tile">
                <span class="fact-label">جمع فاکتورها</span>
                <span class="fact-value amount-value">@_ledger.InvoiceTotal.ToString("N0")</span>
                <span class="fact-hint">@_ledger.InvoiceCount.ToString("N0") فاکتور</span>
            </article>
            <article class="fact-tile">
                <span class="fact-label">جمع واریزی‌ها</span>
                <span class="fact-value amount-value ledger-credit">@_ledger.DepositTotal.ToString("N0")</span>
                <span class="fact-hint">@_ledger.DepositCount.ToString("N0") واریزی</span>
            </article>
            <article class="fact-tile">
                <span class="fact-label">مانده حساب</span>
                <span class="fact-value amount-value @BalanceClass(_ledger.OutstandingBalance)">
                    @_ledger.OutstandingBalance.ToString("N0")
                </span>
                <span class="fact-hint">ریال</span>
            </article>
            <article class="fact-tile">
                <span class="fact-label">شماره دفتر کل</span>
                <span class="fact-value fact-value-sm mono">
                    @(_ledger.GeneralLedgerNumber?.ToString() ?? "—")
                </span>
            </article>
        </section>

        <section class="panel animate-fade-up-delay">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">گردش حساب</h2>
                    <p class="panel-sub">
                        فاکتورها بدهکار و واریزی‌ها بستانکار — مرتب‌شده بر اساس تاریخ
                    </p>
                </div>
            </div>

            @if (_ledger.Entries.Count == 0)
            {
                <div class="table-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Large" />
                    <p>هنوز فاکتور یا واریزی‌ای برای این پروژه ثبت نشده است.</p>
                </div>
            }
            else
            {
                <MudTable Items="_ledger.Entries"
                          Hover="true"
                          Dense="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Sm"
                          Class="data-table ledger-table">
                    <HeaderContent>
                        <MudTh>تاریخ</MudTh>
                        <MudTh>نوع</MudTh>
                        <MudTh>شرح</MudTh>
                        <MudTh>بدهکار</MudTh>
                        <MudTh>بستانکار</MudTh>
                        <MudTh>مانده</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="تاریخ">
                            @PersianDate.Format(context.Date, includeTime: false)
                        </MudTd>
                        <MudTd DataLabel="نوع">
                            <span class="ledger-type @(context.EntryType == ProjectLedgerEntryType.Invoice ? "ledger-type-invoice" : "ledger-type-deposit")">
                                @(context.EntryType == ProjectLedgerEntryType.Invoice ? "فاکتور" : "واریزی")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="شرح">
                            @if (context.EntryType == ProjectLedgerEntryType.Invoice)
                            {
                                <MudLink Underline="Underline.Hover"
                                         Color="Color.Primary"
                                         OnClick="@(() => GoToInvoice(context.RelatedId))">
                                    @context.Description
                                </MudLink>
                            }
                            else
                            {
                                <span>@context.Description</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="بدهکار">
                            @if (context.Debit > 0)
                            {
                                <span class="amount-value ledger-debit">@context.Debit.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="بستانکار">
                            @if (context.Credit > 0)
                            {
                                <span class="amount-value ledger-credit">@context.Credit.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="مانده">
                            <span class="amount-value fw-600 @BalanceClass(context.RunningBalance)">
                                @context.RunningBalance.ToString("N0")
                            </span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProjectLedgerDto? _ledger;
    private bool _isLoading = true;
    private bool _isExporting;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _ledger = await LedgerService.GetByProjectIdAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری دفتر کل: {ex.Message}", Severity.Error);
            _ledger = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExportExcelAsync()
    {
        if (_ledger is null || _isExporting)
            return;

        _isExporting = true;
        try
        {
            var file = await ReportService.ExportExcelAsync(Id);
            if (file is null)
            {
                Snackbar.Add("ساخت فایل اکسل ممکن نشد", Severity.Error);
                return;
            }

            await FileDownload.SaveAsync(Js, file);
            Snackbar.Add("فایل اکسل آماده شد", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در خروجی اکسل: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task ExportPdfAsync()
    {
        if (_ledger is null || _isExporting)
            return;

        _isExporting = true;
        try
        {
            var file = await ReportService.ExportPdfAsync(Id);
            if (file is null)
            {
                Snackbar.Add("ساخت فایل PDF ممکن نشد", Severity.Error);
                return;
            }

            await FileDownload.SaveAsync(Js, file);
            Snackbar.Add("فایل PDF آماده شد", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در خروجی PDF: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private static string BalanceClass(decimal balance) =>
        balance > 0 ? "ledger-balance-due" : balance < 0 ? "ledger-credit" : string.Empty;

    private void GoToProjects() => NavManager.NavigateTo("/projects");

    private void GoToProject() => NavManager.NavigateTo($"/projects/{Id}");

    private void GoToCustomer()
    {
        if (_ledger is not null)
            NavManager.NavigateTo($"/customers/{_ledger.CustomerId}");
    }

    private void GoToInvoice(int invoiceId) => NavManager.NavigateTo($"/invoices/{invoiceId}");
}
